# Server and daily schedule
NODE_ENV=development
PORT=3000
SCHEDULE_CRON="0 9 * * *"
TIMEZONE="Australia/Melbourne"
# The external daily trigger only runs when this local hour is reached.
DAILY_DRAFT_HOUR=9
# Use 24+ random characters. This protects POST /jobs/daily.
CRON_SECRET=replace-with-a-long-random-secret

# Primary provider. When it fails, Groq is attempted if GROQ_API_KEY is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional fallback provider for OpenAI failures. If both fail, the exact
# provider failures are delivered to Telegram and no draft is sent.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Final content fallback. Tavily Search produces an LLM-generated answer based
# on current web sources when OpenAI and Groq both fail.
TAVILY_API_KEY=

# Create two separate Telegram bots with @BotFather. Open each bot and send
# /start before running this service. Get your chat ID from the Bot API's
# getUpdates response after you send the bot a message.
TELEGRAM_X_BOT_TOKEN=
TELEGRAM_X_CHAT_ID=
TELEGRAM_LINKEDIN_BOT_TOKEN=
TELEGRAM_LINKEDIN_CHAT_ID=
# Used by Telegram to authenticate incoming webhook requests.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-url-safe-secret
